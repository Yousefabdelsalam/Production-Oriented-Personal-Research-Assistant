# Copy to .env (never commit .env). All values below are safe placeholders.

# --- Application -----------------------------------------------------------
APP_ENV=development
DATA_DIR=./data
# SQLite by default (zero infrastructure). Alembic migrations run on startup.
# Leave DATABASE_URL unset to use <repo>/data/app.db no matter where the server is started from.
# A RELATIVE sqlite path is resolved against the working directory (backend/ vs repo root => two different databases!),
# so if you set it, use an absolute path, e.g. sqlite:///D:/path/to/repo/data/app.db
# DATABASE_URL=
LOG_LEVEL=INFO
# Optional bearer token. When set, every /api request must send "Authorization: Bearer <token>".
APP_API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Built UI (npm run build) served by the backend at "/". Default: <repo>/frontend/dist
# FRONTEND_DIST=

# --- Upload / fetch limits --------------------------------------------------
MAX_UPLOAD_MB=25
MAX_NOTE_CHARS=200000
FETCH_TIMEOUT_S=15
FETCH_MAX_MB=5
FETCH_MAX_REDIRECTS=5

# --- Hindsight (persistent memory) ----------------------------------------
# This project's DEDICATED Hindsight (docker-compose.hindsight.yml, see docs/hindsight-deployment.md): API on 127.0.0.1:8890.
# If the backend itself runs inside Docker on the pra_hindsight_net network, use http://pra-hindsight:8888 instead.
# Hindsight's own LLM key lives in .env.hindsight, NOT here.
HINDSIGHT_BASE_URL=http://127.0.0.1:8890
HINDSIGHT_API_KEY=
# One bank per workspace: <prefix><workspace-slug>
HINDSIGHT_BANK_PREFIX=pra-
HINDSIGHT_TIMEOUT_S=120
# If true, a source is only "completed" after memory retention succeeded.
HINDSIGHT_REQUIRED=true
# Maximum findings retained into memory per source (quality over quantity).
MEMORY_MAX_FINDINGS_PER_SOURCE=20

# --- Application LLM (optional) --------------------------------------------
# none            -> deterministic "extractive" mode (no model calls; clearly labelled in every response)
# openai_compatible -> any OpenAI-compatible /chat/completions endpoint (OpenAI, Azure proxy, vLLM, LM Studio, ...)
LLM_PROVIDER=none
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# --- Embeddings (optional; lexical BM25 retrieval always works) -------------
EMBEDDING_PROVIDER=none
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- Background worker ------------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_S=1.0
# Re-queue executions that were 'running' when the process died (bounded).
WORKER_AUTO_RESUME_MAX=2
RETRY_BACKOFF_BASE_S=1.0

# --- Pipeline behaviour -----------------------------------------------------
# After a source completes, run cross-source synthesis for the workspace.
AUTO_SYNTHESIZE=true
# After synthesis, propose a living-summary update (still validated + versioned).
AUTO_UPDATE_SUMMARY=false

# Settings for the DEDICATED Hindsight deployment of Personal Research Assistant (docker-compose.hindsight.yml).
# Copy to .env.hindsight (gitignored) and fill in. Every compose command must pass `--env-file .env.hindsight`.
# This file is deliberately SEPARATE from the application's own .env: the Hindsight server uses ITS OWN LLM key
# (for fact extraction / reflect) that is not shared with the app, and not shared with any other project.

# --- Versions (pinned; the app uses hindsight-client 0.10.2) ----------------------------------------------------
PRA_HINDSIGHT_VERSION=0.10.2

# --- Host ports (bound to 127.0.0.1 only) --------------------------------------------------------------------
PRA_HINDSIGHT_API_PORT=8890
PRA_HINDSIGHT_UI_PORT=9990

# --- Dedicated Postgres (not published to the host; only reachable on the pra_hindsight_net network) -----------
# Use a long random value. Letters, digits, - and _ only (it is embedded in a connection URL).
PRA_HINDSIGHT_DB_PASSWORD=change-me-long-random-letters-and-digits

# --- Hindsight's own LLM (REQUIRED for retain / reflect / consolidation) -----------------------------------------
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=gpt-5-mini
# A valid OpenAI API key dedicated to this Hindsight server. Leave empty until you have one.
HINDSIGHT_API_LLM_API_KEY=

# Startup LLM check. Hindsight makes one real LLM call at startup unless this is true.
#   true  = skip it (use while HINDSIGHT_API_LLM_API_KEY is empty; retain will fail until a key is set)
#   false = verify at startup, so a missing/revoked key fails LOUDLY at start instead of silently at the first retain (recommended once a key is set)
HINDSIGHT_API_SKIP_LLM_VERIFICATION=true

HINDSIGHT_API_LOG_LEVEL=info
